generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id      Int          @id @default(autoincrement())
  full_name    String
  phone        String
  email        String       @unique
  password     String
  role         String
  created_at         DateTime     @default(now())
  reset_token        String?
  profile_image      String?
  reset_token_expiry DateTime?

  vaccinations        Vaccination[]
  alerts              Alert[]
  campaignsAsDoctor   RoutineVaccinationCampaign[] @relation("CampaignDoctor")
  routineRecordsGiven RoutineVaccinationRecord[]   @relation("RoutineVaccinationAdmin")
}

model Farm {
  farm_id    Int      @id @default(autoincrement())
  farm_name  String
  location   String
  created_at DateTime @default(now())

  animals   Animal[]
  alerts    Alert[]
  schedules VaccinationSchedule[]
}

enum AnimalStatus {
  Active
  Sold
  Deceased
}

model Animal {
  animal_id       Int          @id @default(autoincrement())
  nickname        String?
  animal_type     String
  biological_type String       @default("Unknown")
  is_pregnant     Boolean      @default(false)
  age             Int
  status          AnimalStatus @default(Active)
  farm_id         Int
  created_at      DateTime     @default(now())

  farm           Farm                       @relation(fields: [farm_id], references: [farm_id])
  vaccinations   Vaccination[]
  schedules      VaccinationSchedule[]
  alerts         Alert[]
  routineRecords RoutineVaccinationRecord[]
}

model Vaccine {
  vaccine_id                Int      @id @default(autoincrement())
  vaccine_name              String
  description               String?
  validity_period_days      Int
  recommended_interval_days Int
  created_at                DateTime @default(now())

  stocks           VaccineStock[]
  vaccinations     Vaccination[]
  schedules        VaccinationSchedule[]
  routineTemplates RoutineVaccinationTemplate[]
  routineCampaigns RoutineVaccinationCampaign[]
  routineRecords   RoutineVaccinationRecord[]
}

model VaccineStock {
  stock_id           Int      @id @default(autoincrement())
  vaccine_id         Int
  supplier_name      String?
  batch_number       String?
  quantity_purchased Int
  quantity_remaining Int
  purchase_price     Float
  purchase_date      DateTime
  expiry_date        DateTime
  created_at         DateTime @default(now())

  vaccine        Vaccine                    @relation(fields: [vaccine_id], references: [vaccine_id])
  vaccinations   Vaccination[]
  routineRecords RoutineVaccinationRecord[]
}

model Vaccination {
  vaccination_id    Int      @id @default(autoincrement())
  animal_id         Int
  vaccine_id        Int
  administered_by   Int
  stock_id          Int
  dosage_ml         Float    @default(0)
  date_administered DateTime
  next_due_date     DateTime
  created_at        DateTime @default(now())

  animal  Animal       @relation(fields: [animal_id], references: [animal_id])
  vaccine Vaccine      @relation(fields: [vaccine_id], references: [vaccine_id])
  user    User         @relation(fields: [administered_by], references: [user_id])
  stock   VaccineStock @relation(fields: [stock_id], references: [stock_id])
}

model VaccinationSchedule {
  schedule_id    Int      @id @default(autoincrement())
  vaccine_id     Int
  farm_id        Int?
  animal_id      Int?
  schedule_type  String
  scheduled_date DateTime
  status         String   @default("Pending")
  created_at     DateTime @default(now())

  vaccine Vaccine @relation(fields: [vaccine_id], references: [vaccine_id])
  farm    Farm?   @relation(fields: [farm_id], references: [farm_id])
  animal  Animal? @relation(fields: [animal_id], references: [animal_id])
}

model Alert {
  alert_id    Int      @id @default(autoincrement())
  animal_id   Int
  farm_id     Int
  user_id     Int      // reported_by
  symptoms    String
  status      String   @default("Pending")
  created_at  DateTime @default(now())

  animal Animal @relation(fields: [animal_id], references: [animal_id])
  farm   Farm   @relation(fields: [farm_id], references: [farm_id])
  user   User   @relation(fields: [user_id], references: [user_id])
}

model VaccineRequest {
  id          Int      @id @default(autoincrement())
  doctorName  String
  vaccineType String
  quantity    Int
  notes       String?
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────
// ROUTINE VACCINATION MODELS
// ─────────────────────────────────────────────────

/// Admin wuxuu abuura hal mar – qeexaya noocu, tallaalka, iyo jadwalka
model RoutineVaccinationTemplate {
  id                   Int      @id @default(autoincrement())
  campaign_name        String
  animal_type          String                       // "Goat" | "Cattle" | "Camel"
  vaccine_id           Int
  frequency_months     Int                          // 6 ama 12 bilood
  reminder_days_before Int      @default(30)
  start_date           DateTime
  status               String   @default("Active") // "Active" | "Inactive"
  created_at           DateTime @default(now())

  vaccine   Vaccine                      @relation(fields: [vaccine_id], references: [vaccine_id])
  campaigns RoutineVaccinationCampaign[]
}

/// System-ku otomaatig wuxuu abuura marka reminder-ka la gaaro
model RoutineVaccinationCampaign {
  id             Int       @id @default(autoincrement())
  template_id    Int
  campaign_name  String
  animal_type    String
  vaccine_id     Int
  due_date       DateTime
  scheduled_date DateTime?
  completed_date DateTime?                      // taariikhda dhabta ah ee la talaalay (wareegga xiga waa laga xisaabiyaa)
  animals_due    Int       @default(0)
  status         String    @default("Upcoming") // Upcoming | Scheduled | InProgress | Completed
  doctor_id      Int?
  created_at     DateTime  @default(now())

  template RoutineVaccinationTemplate @relation(fields: [template_id], references: [id])
  vaccine  Vaccine                    @relation(fields: [vaccine_id], references: [vaccine_id])
  doctor   User?                      @relation("CampaignDoctor", fields: [doctor_id], references: [user_id])
  records  RoutineVaccinationRecord[]
}

/// Waxaa la abuuraa per-animal marka tallaalka la dhameeyo
model RoutineVaccinationRecord {
  id                Int      @id @default(autoincrement())
  campaign_id       Int
  animal_id         Int
  vaccine_id        Int
  administered_by   Int
  stock_id          Int
  dosage_ml         Float?
  date_administered DateTime
  next_due_date     DateTime
  created_at        DateTime @default(now())

  campaign          RoutineVaccinationCampaign @relation(fields: [campaign_id], references: [id])
  animal            Animal                     @relation(fields: [animal_id], references: [animal_id])
  vaccine           Vaccine                    @relation(fields: [vaccine_id], references: [vaccine_id])
  administered_user User                       @relation("RoutineVaccinationAdmin", fields: [administered_by], references: [user_id])
  stock             VaccineStock               @relation(fields: [stock_id], references: [stock_id])
}

// ─────────────────────────────────────────────────
// ACTIVITY LOG MODEL
// ─────────────────────────────────────────────────

model ActivityLog {
  id          Int      @id @default(autoincrement())
  action      String   // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | VACCINATE | STATUS_CHANGE
  entity      String   // Animal | Vaccine | Stock | User | Farm | Vaccination | Schedule | Alert
  entity_id   Int?
  description String
  user_id     Int?
  user_name   String?
  user_role   String?
  ip_address  String?
  created_at  DateTime @default(now())
}